---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const documents = [
  {
    category: "Governance",
    items: [
      { title: "Constitution", file: "/resources/constitution.pdf", status: "Available" },
      { title: "Organizational Profile", file: "/resources/organizational-profile.pdf", status: "Available" },
      { title: "Strategic Plan", file: "#", status: "Coming Soon" },
    ]
  },
  {
    category: "Human Resources",
    items: [
      { title: "Human Resource Policy Manual", file: "/resources/human-resource-policy.pdf", status: "Available" },
      { title: "Volunteer Policy", file: "#", status: "Coming Soon" },
      { title: "Code of Conduct", file: "#", status: "Coming Soon" },
    ]
  },
  {
    category: "Safeguarding",
    items: [
      { title: "Child Protection Policy", file: "#", status: "Coming Soon" },
      { title: "Safeguarding Policy", file: "#", status: "Coming Soon" },
    ]
  },
  {
    category: "Finance",
    items: [
      { title: "Finance Policy", file: "#", status: "Coming Soon" },
      { title: "Procurement Policy", file: "#", status: "Coming Soon" },
    ]
  }
];
---

<Layout title="Resources | Compassion Bridge Initiative Uganda">

<Header />

<section class="resources">

<h1>Resources</h1>

<p class="intro">
Transparency and accountability are central to our work.
Below are key organizational documents available for download.
</p>

{documents.map(section => (

<div class="resource-section">

<h2>{section.category}</h2>

<div class="cards">

{section.items.map(doc => (

<div class="card">

<h3>{doc.title}</h3>

{doc.status === "Available" ? (

<a href={doc.file} target="_blank">
Download PDF
</a>

) : (

<span class="coming">Coming Soon</span>

)}

</div>

))}

</div>

</div>

))}

</section>

<Footer />

</Layout>

<style>
.resources{
max-width:1200px;
margin:auto;
padding:120px 20px 80px;
}

.resources h1{
font-size:48px;
color:#0b4f8a;
margin-bottom:15px;
}

.intro{
font-size:18px;
margin-bottom:50px;
color:#555;
}

.resource-section{
margin-bottom:50px;
}

.resource-section h2{
margin-bottom:20px;
color:#0b4f8a;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:20px;
}

.card{
background:white;
padding:25px;
border-radius:12px;
box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.card h3{
margin-bottom:15px;
}

.card a{
display:inline-block;
background:#0b4f8a;
color:white;
padding:10px 18px;
border-radius:8px;
text-decoration:none;
}

.card a:hover{
background:#083b68;
}

.coming{
color:#999;
font-style:italic;
}
</style>