---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PartnershipHighlight from "../components/PartnershipHighlight.astro";
import About from "../components/About.astro";
import Impact from "../components/Impact.astro";
import Programs from "../components/Programs.astro";
import ImpactNumbers from "../components/ImpactNumbers.astro";
import Gallery from "../components/GalleryNew.astro";
import StoriesOfHope from "../components/StoriesOfHope.astro";
import Leadership from "../components/Leadership.astro";
import Partners from "../components/Partners.astro";
import Donate from "../components/Donate.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Compassion Bridge Initiative Uganda">

  <Header />

  <main>

    <!-- HERO -->
    <section id="home">
      <Hero />
    </section>

    <!-- PARTNERSHIP HIGHLIGHT -->
    <section id="partnership">
      <PartnershipHighlight />
    </section>

    <!-- ABOUT -->
    <section id="about">
      <About />
    </section>

    <!-- IMPACT -->
    <section id="impact">
      <Impact />
    </section>

    <!-- PROGRAMMES -->
    <section id="programs">
      <Programs />
    </section>

    <!-- IMPACT NUMBERS -->
    <section id="impact-numbers">
      <ImpactNumbers />
    </section>

    <!-- GALLERY -->
    <section id="gallery">
      <Gallery />
    </section>

    <!-- STORIES OF HOPE -->
    <section id="stories">
      <StoriesOfHope />
    </section>

    <!-- LEADERSHIP -->
    <section id="leadership">
      <Leadership />
    </section>

    <!-- PARTNERS -->
    <section id="partners">
      <Partners />
    </section>

    <!-- DONATE -->
    <section id="donate">
      <Donate />
    </section>

    <!-- CONTACT -->
    <section id="contact">
      <Contact />
    </section>

  </main>

  <Footer />

</Layout>