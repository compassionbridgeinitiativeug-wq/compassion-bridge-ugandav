---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Impact from "../components/Impact.astro";
import Programs from "../components/Programs.astro";
import Gallery from "../components/Gallery.astro";
import Leadership from "../components/Leadership.astro";
import Partners from "../components/Partners.astro";
import StoriesOfHope from "../components/StoriesOfHope.astro";
import Donate from "../components/Donate.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Compassion Bridge Initiative Uganda">

  <Header />

  <main>

    <section id="home">
      <Hero />
    </section>

    <section id="about">
      <About />
    </section>

    <section id="impact">
      <Impact />
    </section>

    <section id="programs">
      <Programs />
    </section>

    <section id="gallery">
      <Gallery />
    </section>

    <section id="leadership">
      <Leadership />
    </section>

    <section id="partners">
      <Partners />
    </section>

    <!-- NEW SECTION -->
    <section id="stories">
      <StoriesOfHope />
    </section>

    <section id="donate">
      <Donate />
    </section>

    <section id="contact">
      <Contact />
    </section>

  </main>

  <Footer />

</Layout>