---
import HeroButtons from "./HeroButtons.astro";
---

<section id="home" class="hero">

  <img
    src="/pit.png"
    alt="Compassion Bridge Initiative Uganda"
    class="hero-bg"
  />

  <div class="overlay"></div>

  <div class="container hero-content">

    <img
      src="/logocbiu.png"
      alt="CBIU Logo"
      class="hero-logo"
    />

    <span class="welcome">
      COMPASSION BRIDGE INITIATIVE UGANDA
    </span>

    <h1>

      Restoring Dignity.<br>

      Building Futures.

    </h1>

    <p>

      Empowering vulnerable children, women and communities through
      education, health promotion, sustainable livelihoods,
      disability inclusion and compassionate community development.

    </p>

    <HeroButtons />

  </div>

  <div class="scroll-indicator">

      <span></span>

  </div>

</section>

<style>

.hero{

position:relative;

height:100vh;

display:flex;

align-items:center;

justify-content:center;

overflow:hidden;

margin-top:95px;

}

.hero-bg{

position:absolute;

inset:0;

width:100%;

height:100%;

object-fit:cover;

animation:slowZoom 20s ease-in-out infinite alternate;

}

.overlay{

position:absolute;

inset:0;

background:linear-gradient(

90deg,

rgba(8,25,52,.82),

rgba(8,25,52,.58),

rgba(8,25,52,.28)

);

}

.hero-content{

position:relative;

z-index:2;

color:white;

max-width:760px;

animation:fadeUp 1.2s ease;

}

.hero-logo{

width:110px;

margin-bottom:28px;

filter:drop-shadow(0 8px 18px rgba(0,0,0,.35));

}

.welcome{

display:inline-block;

padding:12px 26px;

border-radius:40px;

background:rgba(244,180,0,.18);

border:1px solid rgba(244,180,0,.55);

font-size:14px;

font-weight:700;

letter-spacing:2px;

margin-bottom:28px;

backdrop-filter:blur(8px);

}

.hero h1{

font-size:80px;

line-height:1.03;

font-weight:800;

margin-bottom:30px;

text-shadow:0 8px 22px rgba(0,0,0,.45);

}

.hero p{

font-size:22px;

line-height:1.9;

max-width:680px;

margin-bottom:45px;

text-shadow:0 4px 15px rgba(0,0,0,.3);

}

.scroll-indicator{

position:absolute;

bottom:35px;

left:50%;

transform:translateX(-50%);

}

.scroll-indicator span{

display:block;

width:24px;

height:40px;

border:2px solid white;

border-radius:20px;

position:relative;

opacity:.8;

}

.scroll-indicator span::after{

content:"";

position:absolute;

top:8px;

left:50%;

transform:translateX(-50%);

width:4px;

height:8px;

background:white;

border-radius:4px;

animation:scroll 1.6s infinite;

}

@keyframes scroll{

0%{

opacity:1;

transform:translate(-50%,0);

}

100%{

opacity:0;

transform:translate(-50%,16px);

}

}

@keyframes fadeUp{

from{

opacity:0;

transform:translateY(35px);

}

to{

opacity:1;

transform:translateY(0);

}

}

@keyframes slowZoom{

from{

transform:scale(1);

}

to{

transform:scale(1.08);

}

}

@media(max-width:900px){

.hero{

height:auto;

padding:150px 20px 100px;

text-align:center;

}

.hero-logo{

width:85px;

margin:auto;

margin-bottom:24px;

}

.hero h1{

font-size:48px;

}

.hero p{

font-size:18px;

margin:auto;

margin-bottom:35px;

}

.scroll-indicator{

display:none;

}

}

</style>