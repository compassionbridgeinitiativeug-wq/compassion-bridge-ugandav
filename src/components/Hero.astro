---
import HeroButtons from "./HeroButtons.astro";
---

<section id="home" class="hero">

  <img
    src="/pit.png"
    alt="Compassion Bridge Initiative Uganda"
    class="hero-bg"
  />

  <div class="overlay"></div>

  <div class="container hero-content">

    <span class="welcome">
      COMPASSION BRIDGE INITIATIVE UGANDA
    </span>

    <h1>
      Restoring Dignity.<br />
      Building Futures.
    </h1>

    <p>
      We empower vulnerable children, women and communities through
      education, health promotion, sustainable livelihoods,
      child protection and compassionate community development
      across Uganda.
    </p>

    <HeroButtons />

  </div>

</section>

<style>

.hero{

position:relative;

height:100vh;

display:flex;

align-items:center;

justify-content:center;

overflow:hidden;

margin-top:95px;

}

.hero-bg{

position:absolute;

top:0;

left:0;

width:100%;

height:100%;

object-fit:cover;

animation:slowZoom 18s ease-in-out infinite alternate;

}

.overlay{

position:absolute;

inset:0;

background:
linear-gradient(
90deg,
rgba(9,33,62,.88),
rgba(9,33,62,.72),
rgba(9,33,62,.40)
);

}

.hero-content{

position:relative;

z-index:2;

color:white;

max-width:760px;

animation:fadeUp 1.3s ease;

}

.welcome{

display:inline-block;

padding:12px 24px;

border-radius:40px;

background:rgba(212,160,23,.18);

border:1px solid rgba(212,160,23,.65);

font-size:14px;

font-weight:700;

letter-spacing:2px;

margin-bottom:28px;

backdrop-filter:blur(6px);

}

.hero h1{

font-size:78px;

line-height:1.05;

font-weight:800;

margin-bottom:28px;

text-shadow:0 5px 18px rgba(0,0,0,.35);

}

.hero p{

font-size:23px;

line-height:1.9;

max-width:650px;

margin-bottom:40px;

text-shadow:0 3px 10px rgba(0,0,0,.25);

}

@keyframes fadeUp{

from{

opacity:0;

transform:translateY(35px);

}

to{

opacity:1;

transform:translateY(0);

}

}

@keyframes slowZoom{

from{

transform:scale(1);

}

to{

transform:scale(1.08);

}

}

@media(max-width:900px){

.hero{

height:auto;

padding:140px 0 90px;

text-align:center;

}

.hero-content{

max-width:100%;

padding:0 20px;

}

.hero h1{

font-size:48px;

}

.hero p{

font-size:18px;

margin:auto;

margin-bottom:35px;

}

}

</style>